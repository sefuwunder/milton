[{"id":"R1","name":"Deal has no expected close date","salience":50,"then":[{"aggregate":"{n} deal{s} with no expected close date: {titles}","finding":"no_close","fix":"Set {first} close date to …","icon":"📅"}],"when":[{"all":[{"fact":"d.open","operator":"equal","value":true},{"fact":"d.expected_close","operator":"equal","value":""}],"as":"d","subject":"deal"}]},{"id":"R2","name":"Deal has no value","salience":50,"then":[{"aggregate":"{n} deal{s} with no value set: {titles}","finding":"no_value","fix":"Set {first} value to …","icon":"💰"}],"when":[{"all":[{"fact":"d.open","operator":"equal","value":true},{"fact":"d.value","operator":"equal","value":0}],"as":"d","subject":"deal"}]},{"id":"R3","name":"Stale deal","salience":55,"then":[{"aggregate":"{n} stale deal{s} untouched for 30+ days (oldest first): {titles}","finding":"stale","icon":"🕸️","orderBy":"-d.days_since_update"}],"when":[{"all":[{"fact":"d.open","operator":"equal","value":true},{"fact":"d.days_since_update","operator":"greaterThan","value":30}],"as":"d","subject":"deal"}]},{"id":"R4","name":"Deal has no contact","salience":50,"then":[{"aggregate":"{n} deal{s} with no contact attached: {titles}","finding":"no_contact","icon":"👤"}],"when":[{"all":[{"fact":"d.open","operator":"equal","value":true},{"fact":"d.contact_id","operator":"equal","value":null}],"as":"d","subject":"deal"}]},{"id":"R5","name":"Overdue task","salience":55,"then":[{"aggregate":"{n} overdue task{s}","finding":"overdue","icon":"⏰"}],"when":[{"all":[{"fact":"t.open","operator":"equal","value":true},{"fact":"t.overdue","operator":"equal","value":true}],"as":"t","subject":"task"}]},{"id":"R6","name":"Quiet negotiation","salience":80,"then":[{"finding":"quiet_negotiation","icon":"🚨","text":"{d.title} (${d.value}) is quiet in {d.stage} — no activity in 14 days."},{"assert":"at_risk","facts":{"deal_id":"{d.id}","reason":"quiet_negotiation","title":"{d.title}"}}],"when":[{"all":[{"fact":"d.open","operator":"equal","value":true},{"fact":"d.stage","operator":"in","value":["negotiation","proposal"]}],"as":"d","subject":"deal"},{"not":{"all":[{"fact":"activity.days_ago","operator":"lessThan","value":14}],"subject":"activity","where":{"ref_id":"$d.id","ref_type":"deal"}}}]},{"id":"R7","name":"High-value stall","salience":85,"then":[{"finding":"high_value_stall","fix":"Nudge {d.owner} to follow up on {d.title}","icon":"🚨","text":"{d.title} (${d.value}) is 2× past median dwell in {d.stage} with no activity in 14 days."},{"assert":"at_risk","facts":{"deal_id":"{d.id}","reason":"high_value_stall","title":"{d.title}"}}],"when":[{"all":[{"fact":"d.open","operator":"equal","value":true},{"fact":"d.value","operator":"greaterThan","value":10000}],"as":"d","subject":"deal"},{"all":[{"fact":"dwell.median_dwell","operator":"lessThan","value":"$d.days_since_update/2"}],"subject":"dwell","where":{"stage":"$d.stage"}},{"not":{"all":[{"fact":"activity.days_ago","operator":"lessThan","value":14}],"subject":"activity","where":{"ref_id":"$d.id","ref_type":"deal"}}}]},{"id":"R8a","name":"Win recorded","on":["deal.stage_changed"],"salience":70,"then":[{"assert":"won","facts":{"deal_id":"{event.deal_id}","title":"{event.deal_title}"}}],"when":[{"all":[{"fact":"event.name","operator":"equal","value":"deal.stage_changed"},{"fact":"event.stage_to","operator":"equal","value":"closed_won"}],"subject":"event"}]},{"id":"R8b","name":"Win follow-through","on":["deal.stage_changed"],"salience":70,"then":[{"chips":["Show pipeline","Morning brief"],"suggest":"🎉 {w.title} was won — ask for a referral and log the win story."}],"when":[{"all":[],"as":"w","subject":"won"}]},{"id":"R9","name":"Close-date fantasy","salience":80,"then":[{"finding":"close_date_fantasy","icon":"⚠️","text":"{d.title} closes in {d.days_until_close}d but is still in {d.stage} — is that date real?"}],"when":[{"all":[{"fact":"d.open","operator":"equal","value":true},{"fact":"d.days_until_close","operator":"greaterThanInclusive","value":0},{"fact":"d.days_until_close","operat